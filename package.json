{
  "name": "sallusflow-site",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "quality": "node scripts/quality-gate.mjs",
    "check": "npm run typecheck && npm run test && npm run quality && npm run security && npm run build",
    "security": "node scripts/security-audit.mjs",
    "prebuild": "node scripts/generate-imec-pwa-icons.mjs",
    "postbuild": "node scripts/verify-imec-pwa-icons.mjs"
  },
  "dependencies": {
    "astro": "7.3.6",
    "@astrojs/react": "7.0.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "overrides": {
    "http-cache-semantics": "4.3.0"
  }
}
